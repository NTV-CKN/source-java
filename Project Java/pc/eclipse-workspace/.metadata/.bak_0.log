----------------------------------- SOURCE BEGIN -------------------------------------
package ex4;

import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class Company {
	public List<SaleAgent> listAgent;
	public List<APrice> listPrice;

	public Company() {
		listAgent = new ArrayList<SaleAgent>();
		listPrice = new ArrayList<APrice>();
		Utils.sizeLottery = 10;
		Utils.sizePrize = 3;
		newData(Utils.sizeLottery);
		initPrize(Utils.sizePrize);
	}
	/*
	 * phuong thuc nay nhan vao 1 con so tuong ung voi so thu tu cua danh sach
	 * cac dai li ve so, vd: num = 1 se tuong ung SaleAgent1. Su dung phuong thuc nay
	 * de goi printRandomLottery theo danh sach
	 */
	public String createLottery(int number) {
		try {
			if(number >= 1 && number <= Utils.sizeLottery) {
				return listAgent.get(number - 1).printRamdomLottery();
			}
		} catch (Exception e) {
			System.err.println("KHONG HOP LE!");
		}
		return "";
	}

	public void lotteryDraw()
	
	private void initPrize(int sizePrize) {
		Random random = new Random();
		listPrice.add(
				 new Prize6_45(
						 random.nextInt((int)Math.pow(10, 7), 
						 (int)Math.pow(10, 9)), 
						 Utils.PRIZE_6_45, 
						 "it thi 50k, nhieu thi 5 trieu", 
						 sizePrize)
		   );
			listPrice.get(listPrice.size() - 1).setCompany(this);
			listPrice.add(
					 new Prize6_55(
							 random.nextInt((int)Math.pow(10, 7), 
							 (int)Math.pow(10, 9)), 
							 Utils.PRIZE_6_55, 
							 "it thi 50k, nhieu thi 5 trieu", 
							 sizePrize)
			 );
				listPrice.get(listPrice.size() - 1).setCompany(this);
				listPrice.add(
						 new PrizeMega4(
								 random.nextInt((int)Math.pow(10, 7), 
								 (int)Math.pow(10, 9)), 
								 Utils.PRIZE_MEGA, 
								 "it thi 50k, nhieu thi 5 trieu", 
								 sizePrize)
				);
				listPrice.get(listPrice.size() - 1).setCompany(this);
	}

	private void newData(int size) {
		int count = 0, lotterySize = 3;
		String idSaleAgent = "SaleAgent";
		while (count < size) {
			if (count <= (size - (size * 0.6))) {
				listAgent.add(new SaleAgent(idSaleAgent + count, "HCM", lotterySize));
				listAgent.get(listAgent.size() - 1).setCompany(this);
			} else if (count <= (size - (size * 0.3))) {
				listAgent.add(new SaleAgent(idSaleAgent + count, "HCM", lotterySize));
				listAgent.get(listAgent.size() - 1).setCompany(this);
			} else {
				listAgent.add(new SaleAgent(idSaleAgent + count, "HCM", lotterySize));
				listAgent.get(listAgent.size() - 1).setCompany(this);
			}
			count++;
		}
	}

